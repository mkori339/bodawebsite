COMPOSE_PROJECT_NAME=bodarequest-staging
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=your-github-username
IMAGE_TAG=latest
FRONTEND_PORT=8081
BACKEND_PORT=3002
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-staging-db-password
MYSQL_DATABASE=bodarequest_staging
FRONTEND_URL=http://your-staging-server-ip:8081
JWT_SECRET=change-staging-jwt-secret
